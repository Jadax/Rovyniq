# Private household pilot only. Copy to .env and replace the two placeholder values.
NODE_ENV=production
PORT=3001
OIDC_ISSUER=https://rovyniq-clspws.eu1.zitadel.cloud
# Use the Rovyniq Web application's Client ID from ZITADEL. This is an identifier, not a client secret.
OIDC_AUDIENCE=replace-with-zitadel-web-client-id
OIDC_JWKS_URI=https://rovyniq-clspws.eu1.zitadel.cloud/oauth/v2/keys
OIDC_WEB_CLIENT_ID=replace-with-zitadel-web-client-id
OIDC_CALLBACK_URL=https://tax-pilot.tailddedd2.ts.net/v1/auth/callback
OIDC_AUTHORIZATION_ENDPOINT=https://rovyniq-clspws.eu1.zitadel.cloud/oauth/v2/authorize
OIDC_TOKEN_ENDPOINT=https://rovyniq-clspws.eu1.zitadel.cloud/oauth/v2/token
OIDC_BROWSER_SCOPES=openid profile email urn:zitadel:iam:org:project:roles
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_COOKIE_SECRET=replace-with-a-random-base64url-secret
