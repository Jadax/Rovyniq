# Development only — replace every value with a secret manager in deployed environments.
POSTGRES_DB=rovyniq
POSTGRES_USER=rovyniq_app
POSTGRES_PASSWORD=change-me-local-only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_REALM=rovyniq
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:latest
POSTGRES_IMAGE=postgres:18-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
# OIDC provider values: do not configure these in the public GitHub Pages preview.
OIDC_ISSUER=https://identity.example/realms/rovyniq
OIDC_AUDIENCE=rovyniq-api
# OIDC_JWKS_URI=https://identity.example/realms/rovyniq/protocol/openid-connect/certs
# Browser OIDC values: configure only for the protected application origin, never GitHub Pages.
OIDC_WEB_CLIENT_ID=rovyniq-web
OIDC_CALLBACK_URL=https://app.example.co.za/v1/auth/callback
OIDC_AUTHORIZATION_ENDPOINT=https://identity.example/realms/rovyniq/protocol/openid-connect/auth
OIDC_TOKEN_ENDPOINT=https://identity.example/realms/rovyniq/protocol/openid-connect/token
# Generate 32 or more random bytes and base64url encode them; keep it in the deployment secret manager.
SESSION_COOKIE_SECRET=replace-with-a-random-base64url-secret
