{
  "name": "rovyniq",
  "private": true,
  "version": "0.1.0",
  "description": "Evidence-led South African individual (ITR12) tax preparation.",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "test": "node --experimental-strip-types --test packages/*/src/**/*.test.ts apps/*/src/**/*.test.ts",
    "check": "node --experimental-strip-types scripts/verify-tax-rules.ts && node --experimental-strip-types scripts/verify-docs.ts",
    "test:all": "npm run check && npm test",
    "start:pilot": "node --env-file=.env --experimental-strip-types apps/api/src/server.ts",
    "migrate:postgres": "node --env-file=.env --experimental-strip-types apps/api/src/run-migrations.ts"
  },
  "workspaces": ["apps/*", "packages/*"]
}
